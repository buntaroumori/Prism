# =============================================================================
#  Prism — .gitignore
#  Rule of thumb: anything that can be regenerated from source + lockfiles is
#  ignored. Anything required for a reproducible build (Cargo.lock,
#  pnpm-lock.yaml, icons) is committed.
# =============================================================================

# --- Rust / Cargo ------------------------------------------------------------
/target/
**/target/
**/*.rs.bk
*.pdb
*.dSYM/
*.profraw
*.profdata
*.mm_profdata
perf.data
perf.data.old
flamegraph.svg
cargo-flamegraph/
tracy-*.trace
*.tracy

# --- Node / pnpm -------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
dist/
dist-ssr/
*.local
.vite/
**/.vite/
coverage/
.nyc_output/
*.tsbuildinfo
npm-debug.log*
pnpm-debug.log*
yarn-error.log*
.eslintcache
.react-router/

# --- Tauri / bundling ----------------------------------------------------------
/src-tauri/target/
/src-tauri/gen/schemas/       # regenerated by tauri-build on every build
/src-tauri/gen/android/
/src-tauri/gen/apple/
*.msi
*.msix
*.appx
*.exe
*.dmg
*.app
*.deb
*.rpm
*.AppImage
*.snap
*.flatpak
*.exe.zip
!src-tauri/icons/*.ico

# --- Local databases, caches & logs (runtime state — never in git) --------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
prism.db*
/data/
/logs/
*.log

# --- Secrets & credentials -------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
secrets.json
tauri-signing-*.json
.updater-token
/apple-certs/

# --- Editor / OS junk -------------------------------------------------------------
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
.history/

# --- Scratch / local artefacts ----------------------------------------------------
/scratch/
/tmp/
*.mp3
*.flac
*.m4a
!assets/demo/*.flac
