{
  "name": "prism",
  "private": true,
  "version": "1.1.0",
  "description": "Prism — an audiophile-grade local music player for Windows and Linux",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "schema:validate": "python3 scripts/validate_schema.py",
    "icons": "tauri icon assets/icon.png",
    "perf": "vite build --config vite.bench.config.ts && node scripts/perf-audit.mjs --no-build",
    "perf:build": "vite build --config vite.bench.config.ts",
    "licenses": "node scripts/license-audit.mjs",
    "licenses:check": "node scripts/license-audit.mjs --check",
    "smoke": "node scripts/smoke-ui.mjs",
    "behaviour": "node scripts/ui-behaviour.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.5",
    "@tanstack/react-virtual": "^3.14.22",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.3",
    "@tauri-apps/plugin-opener": "~2.7.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.0.0",
    "zod": "^3.24.2",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^22.13.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "eslint": "^9.22.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^16.0.0",
    "playwright": "1.64.1",
    "prettier": "^3.5.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.3.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@tauri-apps/cli"
    ]
  }
}
