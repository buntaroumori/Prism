{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Capabilities granted to the single Prism window. Every permission is the minimum required; the audio engine, filesystem scanner and network fetchers run in Rust and never rely on webview privileges.",
  "local": true,
  "windows": ["main"],
  "platforms": ["windows", "linux"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-minimize",
    "core:window:allow-close",
    "core:window:allow-set-focus",
    "core:window:allow-set-title",
    "dialog:default",
    "opener:default"
  ]
}
